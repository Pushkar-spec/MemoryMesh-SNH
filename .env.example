# MemoryMesh Environment Configuration Example
# Copy this file to .env and configure appropriate values.

# LLM Provider selection: gemini | anthropic | fake
# Set to 'gemini' for Google Gemini API, 'anthropic' for Claude, or 'fake' for offline testing.
LLM_PROVIDER=gemini

# Provider API Keys (required when LLM_PROVIDER is 'gemini' or 'anthropic')
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

