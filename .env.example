# MemoryMesh Environment Configuration Example
# Copy this file to .env and configure appropriate values.

# LLM Provider selection: anthropic | gemini | fake
# Set to 'fake' for offline development and test execution without API keys.
LLM_PROVIDER=fake

# Provider API Keys (required when LLM_PROVIDER is 'anthropic' or 'gemini')
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

